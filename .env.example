# Domain pointing to the VPS (DNS A record -> VPS IP), e.g. pokemmo.example.com
DOMAIN=
# Optional: other addresses redirected to DOMAIN, comma-separated, e.g. www.example.com, old.example.com
REDIRECT_FROM=
# Private game code: share https://<DOMAIN>/?code=<GAME_CODE>. Empty = open to everyone.
# Generate one with: openssl rand -hex 6
GAME_CODE=
# Optional: AI dialogue for NPCs
OPENAI_API_KEY=
MOLROO_API_KEY=
